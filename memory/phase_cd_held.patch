+
+@pytest.mark.parametrize("sched,msg", [
+    ({"type": "RECURRING", "weekdays": [], "months": 3}, "weekday"),
+    ({"type": "RECURRING", "weekdays": [1, 2, 3, 4, 5, 6], "months": 3}, "weekday"),
+    ({"type": "RECURRING", "weekdays": [8], "months": 3}, "weekday"),
+    ({"type": "RECURRING", "weekdays": [2], "months": 2}, "length"),
+])
+def test_invalid_schedules_rejected(org_id, programme_id, sched, msg):
+    r = _create(org_id, programme_id, event_date=_future(10), schedule=sched)
+    assert r.status_code == 400 and msg in r.json()["detail"].lower()
+
+
+def test_lifecycle_live_between_first_and_last_session():
+    import institutional as I
+    today = dt.date.today()
+    ev = {"lifecycle": "PUBLISHED", "event_date": (today - dt.timedelta(days=7)).isoformat(),
+          "end_date": (today + dt.timedelta(days=30)).isoformat()}
+    assert I._effective_lifecycle(ev) == "LIVE"
+    ev["end_date"] = (today - dt.timedelta(days=1)).isoformat()
+    assert I._effective_lifecycle(ev) == "COMPLETED"
+    single = {"lifecycle": "PUBLISHED", "event_date": (today - dt.timedelta(days=1)).isoformat()}
+    assert I._effective_lifecycle(single) == "COMPLETED"  # single-day behaviour unchanged
+
+
+def test_add_months_clamps_month_end():
+    import institutional as I
+    assert I._add_months(dt.date(2027, 1, 31), 1) == dt.date(2027, 2, 28)
+    assert I._add_months(dt.date(2027, 11, 15), 3) == dt.date(2028, 2, 15)

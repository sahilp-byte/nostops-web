+    lst = requests.get(f"{BASE}/organisations", headers=_h(claim), timeout=15).json()["organisations"]
+    mine = [o for o in lst if o["organisation_id"] == oid]
+    assert mine and mine[0]["my_role"] == "OWNER"
+    status = requests.get(f"{API}/org-enquiries/{eid}", headers=_h(admin), timeout=15).json()

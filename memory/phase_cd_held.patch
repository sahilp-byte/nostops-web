+// Phase C/D pure-logic checks — schedule generation, price estimate inputs,
+// programme suggestions. Run: node tests/verify_phase_cd.ts
+import { formatDate, sessionDates, weekdayList } from '../lib/org/schedule.ts';
+import { RECOMMENDED, recommendedFor } from '../lib/org/recommendations.ts';
+import { estimate, SESSIONS_PER_MONTH } from '../lib/org/pricing.ts';
+
+let failures = 0;
+function check(name: string, cond: boolean, got?: unknown) {
+  if (cond) console.log(`  \u2713 ${name}`);

+# ── Multi-session programme schedule (Phase C) ───────────────────────────────
+# One event = one programme; participants register ONCE for the whole series.
+# A RECURRING schedule repeats on chosen weekdays (ISO 1=Mon … 7=Sun) from a
+# start date for 1/3/6/12 calendar months. event_date = first session,
+# end_date = last session; the generated sessions live in inst_event_sessions.
+SCHEDULE_MONTHS = (1, 3, 6, 12)
+SCHEDULE_MAX_WEEKDAYS = 5
+_WEEKDAY_NAMES = ["", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+
+
+class ScheduleIn(BaseModel):
+    type: str = "SINGLE"                 # SINGLE | RECURRING
+    weekdays: List[int] = []
+    months: int = 1
+
+
+def _normalise_schedule(s: Optional[ScheduleIn]) -> dict:
+    if not s or (s.type or "").strip().upper() != "RECURRING":
+        return {"type": "SINGLE"}
+    days = sorted(set(s.weekdays or []))
+    if not days or any(d < 1 or d > 7 for d in days) or len(days) > SCHEDULE_MAX_WEEKDAYS:
+        raise HTTPException(status_code=400, detail="Choose between 1 and 5 weekdays for a repeating programme.")
+    if s.months not in SCHEDULE_MONTHS:
+        raise HTTPException(status_code=400, detail="Programme length must be 1, 3, 6 or 12 months.")
+    return {"type": "RECURRING", "weekdays": days, "months": s.months}
+
+
+def _add_months(d: _dt.date, months: int) -> _dt.date:
+    m = d.month - 1 + months
+    y, m = d.year + m // 12, m % 12 + 1
+    last_day = [31, 29 if (y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)) else 28,
+                31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
+    return _dt.date(y, m, min(d.day, last_day))
+
+
+def _schedule_dates(ev: dict) -> List[_dt.date]:
+    """Session dates for a RECURRING schedule: every chosen weekday from the
+    start date up to (not including) start + N calendar months."""
+    s = ev.get("schedule") or {}
+    if s.get("type") != "RECURRING":
+        return []
+    start = _parse_date(s.get("start_date") or ev.get("event_date"))
+    if not start:
+        return []
+    end = _add_months(start, int(s.get("months") or 1))
+    days = set(s.get("weekdays") or [])
+    out, d = [], start
+    while d < end:
+        if d.isoweekday() in days:
+            out.append(d)
+        d += _dt.timedelta(days=1)
+    return out
+
+
+def _schedule_patch(ev: dict) -> dict:
+    """Derived schedule fields: first/last session dates + session count."""
+    s = ev.get("schedule") or {}
+    if s.get("type") != "RECURRING":
+        return {"end_date": None}
+    dates = _schedule_dates(ev)
+    if not dates:
+        return {"end_date": None, "schedule": {**s, "session_count": 0}}
+    return {"event_date": dates[0].isoformat(), "end_date": dates[-1].isoformat(),
+            "schedule": {**s, "session_count": len(dates)}}
+
+
+async def _write_sessions(ev: dict) -> None:
+    """Replace the event's generated sessions (idempotent on every save)."""
+    await event_sessions.delete_many({"event_id": ev["event_id"]})
+    dates = _schedule_dates(ev)
+    if not dates:
+        return
+    now = _now()
+    await event_sessions.insert_many([{
+        "session_id": f"{ev['event_id']}-S{i:03d}",
+        "event_id": ev["event_id"],
+        "seq": i,
+        "date": d.isoformat(),
+        "start_time": ev.get("start_time"),
+        "duration_minutes": ev.get("duration_minutes") or 60,
+        "timezone": ev.get("timezone") or DEFAULT_TIMEZONE,
+        "starts_at": f"{d.isoformat()}T{ev.get('start_time') or '00:00'}",
+        "status": "SCHEDULED",
+        "created_at": now,
+    } for i, d in enumerate(dates, start=1)])
+
+
+def _when(ev: dict, fallback: str) -> str:
+    """Human 'when' line for emails — a repeating programme names its series."""
+    base = " · ".join([x for x in [ev.get("event_date"), ev.get("start_time")] if x])
+    s = ev.get("schedule") or {}
+    if base and s.get("type") == "RECURRING" and s.get("session_count"):
+        days = " & ".join(_WEEKDAY_NAMES[d] for d in s.get("weekdays") or [])
+        return f"{base} (first of {s['session_count']} sessions, every {days} until {ev.get('end_date')})"
+    return base or fallback
+
+
+def _price_estimate(ev: dict) -> Optional[dict]:
+    """Organiser-only estimate from the published organisation rates, saved with
+    the event for reference (never shown publicly; final pricing by NOSTOPS)."""
+    cohort, cap = ev.get("cohort_type"), ev.get("capacity")
+    if cohort not in org_pricing.COHORT_RATES or not isinstance(cap, int) or cap < 1:
+        return None
+    s = ev.get("schedule") or {}
+    if s.get("type") == "RECURRING":
+        months = int(s.get("months") or 1)
+        sessions = s.get("session_count") or org_pricing.SESSIONS_PER_MONTH * months
+    else:
+        months, sessions = 1, 1
+    lo, hi = org_pricing.PARTICIPANT_RANGE
+    return {**org_pricing.estimate(cohort, months, cap, sessions), "months": months, "participants": cap,
+            "cohort": cohort, "currency": "INR", "within_published_range": lo <= cap <= hi,
+            "basis": "NOSTOPS published organisation rates", "computed_at": _now()}
+
+

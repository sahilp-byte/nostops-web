+// Programme suggestions by organisation type (Phase D) — fixed, editorial rules
+// keyed on the Council programme slug. Shown as "Recommended for your
+// organisation" at the top of the Event Creator's Programme step. Any programme
+// can still be chosen; slugs that are not in the catalogue are simply skipped.
+import type { CohortKey } from '@/lib/org/cohort-copy';
+
+export type Suggestion = { slug: string; reason: string };
+
+export const RECOMMENDED: Record<CohortKey, Suggestion[]> = {
+  COMPANY: [
+    { slug: 'yoga-for-posture-back-care', reason: 'Eases desk-bound stiffness for teams who sit most of the day' },
+    { slug: 'yoga-for-stress-resilience', reason: 'Helps teams handle workload pressure and stay steady' },
+    { slug: 'yoga-for-focus-attention', reason: 'Supports focus through meeting-heavy, deep-work days' },
+  ],
+  EDUCATIONAL_INSTITUTION: [
+    { slug: 'yoga-for-focus-attention', reason: 'Supports concentration for study and exam readiness' },
+    { slug: 'yoga-for-emotional-wellbeing', reason: 'Builds emotional balance through the academic year' },
+    { slug: 'yoga-for-stress-resilience', reason: 'Helps students and faculty settle exam-season stress' },
+  ],
+  STARTUP_NETWORK: [
+    { slug: 'yoga-for-stress-resilience', reason: 'Steadies founders and teams through high-pressure growth' },
+    { slug: 'yoga-for-energy-stamina', reason: 'Sustains energy for long build-and-ship cycles' },
+    { slug: 'yoga-for-focus-attention', reason: 'Sharpens focus for clear decision-making' },
+  ],
+};
+
+export function recommendedFor<P extends { slug?: string | null }>(cohort: string, programmes: P[]): { prog: P; reason: string }[] {
+  const rules = RECOMMENDED[cohort as CohortKey] || [];
+  return rules
+    .map((r) => ({ prog: programmes.find((p) => p.slug === r.slug), reason: r.reason }))
+    .filter((x): x is { prog: P; reason: string } => !!x.prog);
+}
diff --git a/frontend/lib/org/schedule.ts b/frontend/lib/org/schedule.ts
new file mode 100644
index 00000000..584279f3
--- /dev/null
+++ b/frontend/lib/org/schedule.ts
@@ -0,0 +1,52 @@
+// Repeating programme schedule — mirrors backend institutional._schedule_dates
+// (every chosen weekday from the start date, up to start + N calendar months).
+// Dates are handled in UTC so the preview never shifts across time zones.
+
+export type ScheduleValue = { type: 'SINGLE' | 'RECURRING'; weekdays: number[]; months: number };
+
+export const WEEKDAYS: { n: number; short: string }[] = [
+  { n: 1, short: 'Mon' }, { n: 2, short: 'Tue' }, { n: 3, short: 'Wed' }, { n: 4, short: 'Thu' },
+  { n: 5, short: 'Fri' }, { n: 6, short: 'Sat' }, { n: 7, short: 'Sun' },
+];
+export const SCHEDULE_MONTHS = [1, 3, 6, 12] as const;
+export const MAX_WEEKDAYS = 5;
+
+function parse(iso: string): Date | null {
+  if (!/^\d{4}-\d{2}-\d{2}/.test(iso || '')) return null;
+  const d = new Date(`${iso.slice(0, 10)}T00:00:00Z`);
+  return Number.isNaN(d.getTime()) ? null : d;
+}
+
+function addMonths(d: Date, months: number): Date {
+  const total = d.getUTCMonth() + months;
+  const y = d.getUTCFullYear() + Math.floor(total / 12);
+  const m = total % 12;
+  const lastDay = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
+  return new Date(Date.UTC(y, m, Math.min(d.getUTCDate(), lastDay)));
+}
+
+export function sessionDates(start: string, weekdays: number[], months: number): string[] {
+  const s = parse(start);
+  if (!s || !weekdays.length) return [];
+  const end = addMonths(s, months);
+  const days = new Set(weekdays);
+  const out: string[] = [];
+  for (const d = new Date(s); d < end; d.setUTCDate(d.getUTCDate() + 1)) {
+    if (days.has(d.getUTCDay() || 7)) out.push(d.toISOString().slice(0, 10));
+  }
+  return out;
+}
+
+// [2, 4] → "Tue & Thu"; [1, 3, 5] → "Mon, Wed & Fri"
+export function weekdayList(days: number[]): string {
+  const names = [...days].sort((a, b) => a - b).map((n) => WEEKDAYS[n - 1]?.short).filter(Boolean);
+  return names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names[names.length - 1]}` : names[0] || '';
+}
+
+export function formatDate(iso?: string | null, withWeekday = false): string {
+  const d = iso ? parse(iso) : null;
+  if (!d) return iso || '';
+  return d.toLocaleDateString('en-GB', {
+    timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric', ...(withWeekday ? { weekday: 'short' } : {}),
+  });
+}

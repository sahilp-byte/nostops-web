+# ── Price estimate ───────────────────────────────────────────────────────────
+def test_single_session_estimate_and_education_flat_rate(programme_id):
+    r = requests.post(f"{BASE}/organisations", headers=_h(CREATOR), timeout=15, json={
+        "name": f"QA PhaseCD Campus {RUN}", "cohort_type": "EDUCATIONAL_INSTITUTION", "contact_email": "dean@qa-phasecd.example"})

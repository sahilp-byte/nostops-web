+"""Published organisation programme rates — the Python mirror of
+frontend/lib/org/pricing.ts (parity is enforced by tests/test_phase_cd_features.py).
+
+Model: a rate per participant, per session. Companies and startup / networking
+groups get commitment discounts by group size and programme length; the campus
+rate is flat. These are ESTIMATES for the organiser — final pricing is always
+confirmed by NOSTOPS.
+"""
+from typing import Optional
+
+SESSIONS_PER_MONTH = 8
+MONTH_STEPS = (1, 3, 6, 12)
+PARTICIPANT_RANGE = (15, 40)
+
+COHORT_RATES = {
+    "EDUCATIONAL_INSTITUTION": {"rate": 175, "discounted": False},
+    "COMPANY": {"rate": 300, "discounted": True},
+    "STARTUP_NETWORK": {"rate": 300, "discounted": True},
+}
+
+DISCOUNT_TIERS = [
+    {"tier": "Tier 1", "min": 15, "max": 28, "pct": {1: 0, 3: 10, 6: 12.5, 12: 15}},
+    {"tier": "Tier 2", "min": 29, "max": 40, "pct": {1: 0, 3: 20, 6: 25, 12: 30}},
+]
+
+
+def tier_for(participants: int) -> dict:
+    return DISCOUNT_TIERS[1] if participants >= DISCOUNT_TIERS[1]["min"] else DISCOUNT_TIERS[0]
+
+
+def estimate(cohort: str, months: int, participants: int, sessions: Optional[int] = None) -> dict:
+    c = COHORT_RATES[cohort]
+    sessions = SESSIONS_PER_MONTH * months if sessions is None else sessions
+    pct = tier_for(participants)["pct"][months] if c["discounted"] else 0
+    rate = c["rate"] * (100 - pct) / 100
+    per_person = rate * sessions
+    return {
+        "sessions": sessions,
+        "pct": pct,
+        "list_rate": c["rate"],
+        "rate": rate,
+        "per_person": per_person,
+        "total": per_person * participants,
+        "list_total": c["rate"] * sessions * participants,
+    }

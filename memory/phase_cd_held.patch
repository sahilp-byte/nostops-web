+# ── Enquiry → Organisation (Phase D) ──────────────────────────────────────────
+# An admin turns an organisation enquiry into a ready Organisation in one click.
+# The org has NO member yet: it is held for the enquiry's contact email
+# (pending_owner_email) and joins that person's account as OWNER the first time
+# they sign in with that email (claimed in the org/event list reads below).
+async def create_org_from_enquiry(enq: dict, admin: dict) -> dict:
+    await _ensure()
+    cohort = (enq.get("cohort") or "").strip().upper()
+    if cohort not in COHORT_TYPES:
+        raise HTTPException(status_code=400, detail="This enquiry has no valid organisation type.")
+    email = _norm_email(enq.get("email"))
+    if not email:
+        raise HTTPException(status_code=400, detail="The enquiry has no contact email to invite.")
+    # Enquiry phones were validated loosely — keep one only if it meets the org rule.
+    phone = (enq.get("phone") or "").strip() or None
+    try:
+        _validate_org_contact(email, phone)
+    except HTTPException:
+        phone = None
+    name = (enq.get("organisation_name") or "").strip()[:160]
+    city = (enq.get("city") or "").strip() or None
+    city_slug = _city_slug(city)
+    org_id = await _next_id("Organisation")
+    now = _now()
+    doc = {
+        "organisation_id": org_id,
+        "name": name,
+        "slug": f"{_slugify(name)}-{org_id[-6:]}",
+        "cohort_type": cohort,
+        "description": None,
+        "logo_url": None,
+        "website": None,
+        "primary_city": city,
+        "city_slug": city_slug,
+        "is_launch_city": city_slug in LAUNCH_CITY_SLUGS if city_slug else False,
+        "contact_email": email,
+        "email_domain": email.split("@", 1)[1],
+        "contact_person": (enq.get("contact_name") or "").strip()[:120] or None,
+        "contact_phone": phone,
+        "trust_state": ORG_TRUST_UNVERIFIED,
+        "domain_verified": False,
+        "source_enquiry_id": enq.get("_id") or enq.get("id"),
+        "source_enquiry_ref": enq.get("ref"),
+        "pending_owner_email": email,
+        "pending_owner_name": (enq.get("contact_name") or "").strip()[:120] or None,
+        "pending_owner_claimed_at": None,
+        "created_by": str(admin.get("user_id")),
+        "created_at": now,
+        "updated_at": now,
+    }
+    await organisations.insert_one(dict(doc))

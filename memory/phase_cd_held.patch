+def test_recurring_public_page_hides_price_and_shows_schedule():
+    creator = {"user_id": f"qa_iter157_{RUN}", "name": "Iter157", "email": f"iter157.{RUN}@nostopsqa.com", "role": "hr"}
+    r = requests.post(f"{BASE}/organisations", headers=_h(creator), timeout=15, json={
+        "name": f"QA Iter157 Co {RUN}", "cohort_type": "COMPANY", "contact_email": "p@qa.example"})
+    assert r.status_code == 200, r.text
+    oid = r.json()["organisation"]["organisation_id"]
+    pid = next(p["programme_id"] for p in requests.get(f"{BASE}/programmes", headers=_h(), timeout=15).json()["programmes"]
+               if p["slug"] == "yoga-for-posture-back-care")
+    body = {"organisation_id": oid, "programme_id": pid, "title": f"Iter157 Rec {RUN}", "city": "Mumbai",
+            "visibility": "PUBLIC", "start_time": "07:30", "duration_minutes": 45,
+            "event_date": _future(14), "capacity": 20,
+            "schedule": {"type": "RECURRING", "weekdays": [2, 4], "months": 1}}
+    created = requests.post(f"{BASE}/events", headers=_h(creator), json=body, timeout=15)
+    assert created.status_code == 200, created.text
+    ev = created.json()["event"]
+    assert ev["price_estimate"] is not None  # organiser side has estimate
+    pub = requests.post(f"{BASE}/events/{ev['event_id']}/publish", headers=_h(creator), timeout=30)
+    assert pub.status_code == 200, pub.text
+    slug = pub.json()["event"]["slug"]
+    page = requests.get(f"{BASE}/public/events/{slug}", headers=_h(), timeout=15).json()["event"]
+    assert "price_estimate" not in page
+    assert page["schedule"]["type"] == "RECURRING" and page["schedule"]["weekdays"] == [2, 4]
+    assert page["end_date"] and page["sessions"] and len(page["sessions"]) == page["schedule"]["session_count"]
+    assert all("date" in s and "start_time" in s for s in page["sessions"])
+
+
+def test_claim_and_non_admin_guard():
+    eid = f"iter157-{uuid.uuid4().hex[:10]}"
+    DB.org_enquiries.insert_one({
+        "_id": eid, "ref": f"ENQ-ITER157-{RUN}", "organisation_name": f"TEST Iter157 Enq {RUN}",
+        "contact_name": "Iter157 QA", "designation": "Lead", "email": "delivered@resend.dev",
+        "phone": "+91 98200 11111", "cohort": "COMPANY", "city": "Mumbai", "participants": "15_28",
+        "interests": ["MIND"], "duration": "3_MONTHS", "start_period": "NEXT_MONTH", "message": None,
+        "stage": "WON", "history": [], "notes": [],
+        "created_at": "2026-01-01T00:00:00+00:00", "updated_at": "2026-01-01T00:00:00+00:00"})
+    non_admin = {"user_id": f"qa_hr_{RUN}", "name": "Not Admin", "email": "x@y.z", "role": "hr"}
+    r = requests.post(f"{API}/org-enquiries/{eid}/create-organisation", headers=_h(non_admin), timeout=15)
+    assert r.status_code == 403
+    admin = {"user_id": "qa_admin_iter157", "name": "Admin", "role": "admin"}
+    r = requests.post(f"{API}/org-enquiries/{eid}/create-organisation", headers=_h(admin), timeout=30)
+    assert r.status_code == 200
+    oid = r.json()["organisation"]["organisation_id"]

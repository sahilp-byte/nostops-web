@@ -0,0 +1,76 @@
+// Single session vs repeating programme (Phase C). A repeating programme runs on
+// the chosen weekdays from the start date for 1/3/6/12 months; participants
+// register once for the whole series.
+import { MAX_WEEKDAYS, SCHEDULE_MONTHS, WEEKDAYS, formatDate, weekdayList, type ScheduleValue } from '@/lib/org/schedule';
+
+const PREVIEW = 6;
+
+export default function ScheduleBuilder({ value, onChange, dates, startDate }: {
+  value: ScheduleValue;
+  onChange: (v: ScheduleValue) => void;
+  dates: string[];
+  startDate: string;
+}) {
+  const recurring = value.type === 'RECURRING';
+  const toggleDay = (n: number) => {
+    const has = value.weekdays.includes(n);
+    if (!has && value.weekdays.length >= MAX_WEEKDAYS) return;
+    onChange({ ...value, weekdays: has ? value.weekdays.filter((d) => d !== n) : [...value.weekdays, n].sort((a, b) => a - b) });
+  };
+  const seg = (on: boolean) => `flex-1 rounded-lg px-3 py-2 text-sm font-bold transition ${on ? 'bg-white text-brand-700 shadow-sm' : 'text-muted'}`;
+
+  return (
+    <div className="rounded-2xl border border-line bg-cream/50 p-4" data-testid="schedule-builder">
+      <p className="text-xs font-bold uppercase tracking-wider text-muted">Schedule</p>
+      <div className="mt-2 flex gap-2 rounded-xl bg-cream p-1">
+        <button type="button" className={seg(!recurring)} onClick={() => onChange({ ...value, type: 'SINGLE' })} data-testid="sched-single" aria-pressed={!recurring}>Single session</button>
+        <button type="button" className={seg(recurring)} onClick={() => onChange({ ...value, type: 'RECURRING' })} data-testid="sched-recurring" aria-pressed={recurring}>Repeating programme</button>
+      </div>
+
+      {recurring && (
+        <div className="mt-3 space-y-3">
+          <div>
+            <p className="text-xs font-semibold text-ink-soft">Repeats every</p>
+            <div className="mt-1.5 flex flex-wrap gap-1.5">
+              {WEEKDAYS.map((d) => {
+                const on = value.weekdays.includes(d.n);
+                return (
+                  <button key={d.n} type="button" onClick={() => toggleDay(d.n)} aria-pressed={on} data-testid={`sched-day-${d.n}`}
+                    className={`min-h-[40px] min-w-[48px] rounded-lg border px-2 text-xs font-bold transition ${on ? 'border-brand bg-brand text-white' : 'border-line bg-white text-ink-soft'}`}>
+                    {d.short}
+                  </button>
+                );
+              })}
+            </div>
+            <p className="mt-1 text-[11px] text-muted">Our published plans run 2 sessions a week · up to {MAX_WEEKDAYS} days.</p>
+          </div>
+          <div>
+            <label className="text-xs font-semibold text-ink-soft" htmlFor="sched-months">Programme length</label>
+            <select id="sched-months" value={value.months} onChange={(e) => onChange({ ...value, months: Number(e.target.value) })} data-testid="sched-months"
+              className="mt-1 w-full rounded-xl border border-line bg-white px-3 py-2.5 text-sm text-ink outline-none focus:border-brand">
+              {SCHEDULE_MONTHS.map((m) => <option key={m} value={m}>{m} month{m === 1 ? '' : 's'}</option>)}
+            </select>
+          </div>
+          <div className="rounded-xl bg-white p-3 text-sm" data-testid="sched-preview">
+            {!startDate ? (
+              <p className="text-xs text-muted">Pick a start date below to see every session.</p>
+            ) : !value.weekdays.length ? (
+              <p className="text-xs font-semibold text-rose-600">Choose at least one weekday.</p>
+            ) : (
+              <>
+                <p className="font-bold text-ink" data-testid="sched-summary">
+                  {dates.length} sessions · every {weekdayList(value.weekdays)}
+                </p>
+                <p className="text-xs text-muted">{formatDate(dates[0])} → {formatDate(dates[dates.length - 1])} · participants register once for all sessions</p>
+                <div className="mt-2 flex flex-wrap gap-1">
+                  {dates.slice(0, PREVIEW).map((d) => <span key={d} className="rounded-md bg-cream px-2 py-0.5 text-[11px] font-semibold text-ink-soft">{formatDate(d, true)}</span>)}
+                  {dates.length > PREVIEW && <span className="px-1 text-[11px] font-semibold text-muted">+{dates.length - PREVIEW} more</span>}
+                </div>
+              </>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}

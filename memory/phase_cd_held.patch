diff --git a/frontend/components/app/org/events/PriceEstimate.tsx b/frontend/components/app/org/events/PriceEstimate.tsx
new file mode 100644
index 00000000..af73e663
--- /dev/null
+++ b/frontend/components/app/org/events/PriceEstimate.tsx
@@ -0,0 +1,51 @@
+// Organiser-only price estimate (Phase C) from the published organisation rates
+// (lib/org/pricing.ts). The backend saves the same figures with the event.
+import type { CohortKey } from '@/lib/org/cohort-copy';
+import { COHORT_RATES, PARTICIPANT_RANGE, estimate, inr, inrRate, type Months } from '@/lib/org/pricing';
+
+export default function PriceEstimate({ cohort, participants, months, sessions }: {
+  cohort: string;
+  participants: number | null;
+  months: number;
+  sessions: number;
+}) {
+  if (!(cohort in COHORT_RATES)) return null;
+  const c = COHORT_RATES[cohort as CohortKey];
+  const e = participants ? estimate(cohort as CohortKey, months as Months, participants, sessions) : null;
+  const outside = !!participants && (participants < PARTICIPANT_RANGE.min || participants > PARTICIPANT_RANGE.max);
+  return (
+    <div className="rounded-2xl border border-brand/30 bg-brand-50/60 p-4" data-testid="price-estimate">
+      <p className="text-xs font-bold uppercase tracking-wider text-muted">Price estimate <span className="normal-case tracking-normal">· only you see this</span></p>
+      {!e ? (
+        <p className="mt-2 text-xs text-ink-soft" data-testid="price-estimate-empty">Add your expected number of participants (capacity) to see an estimate.</p>
+      ) : (
+        <>
+          <p className="mt-2 text-2xl font-black text-ink" data-testid="price-estimate-total">{inr(e.total)}</p>
+          <p className="text-xs text-ink-soft">for {participants} {c.people} · {sessions} session{sessions === 1 ? '' : 's'}</p>
+          <dl className="mt-3 space-y-1 text-xs">
+            <div className="flex justify-between gap-2">
+              <dt className="text-muted">Per participant, per session</dt>
+              <dd className="font-bold text-ink" data-testid="price-estimate-rate">
+                {e.pct ? <s className="mr-1 font-normal text-muted">{inrRate(e.listRate)}</s> : null}{inrRate(e.rate)}
+              </dd>
+            </div>
+            <div className="flex justify-between gap-2">
+              <dt className="text-muted">{c.discounted ? 'Commitment discount' : 'Campus rate'}</dt>
+              <dd className="font-bold text-ink" data-testid="price-estimate-discount">{c.discounted ? (e.pct ? `${e.pct}%` : 'None for 1 month') : 'Flat · no discounts'}</dd>
+            </div>
+            <div className="flex justify-between gap-2">
+              <dt className="text-muted">Per participant, whole programme</dt>
+              <dd className="font-bold text-ink">{inr(e.perPerson)}</dd>
+            </div>
+          </dl>
+          {outside && (
+            <p className="mt-2 text-[11px] font-semibold text-amber-700" data-testid="price-estimate-range">
+              Published rates cover groups of {PARTICIPANT_RANGE.min}–{PARTICIPANT_RANGE.max}; NOSTOPS will confirm pricing for your group size.
+            </p>
+          )}
+        </>
+      )}
+      <p className="mt-2 text-[11px] text-muted">Based on NOSTOPS published organisation rates. Final pricing is confirmed by NOSTOPS; participants never see this estimate.</p>
+    </div>
+  );
+}

@@ -0,0 +1,56 @@
+'use client';
+// Admin enquiry → Organisation (Phase D). One click builds the organisation from
+// the enquiry; it joins the contact's account the first time they sign in with
+// the enquiry email.
+import { useState } from 'react';
+import { useRouter } from 'next/navigation';
+import { postBff } from '@/lib/auth-client';
+import type { OrgEnquiry } from '@/lib/server/org-enquiries';
+
+export default function CreateOrgFromEnquiry({ e }: { e: OrgEnquiry }) {
+  const router = useRouter();
+  const [busy, setBusy] = useState(false);
+  const [err, setErr] = useState('');
+  const org = e.organisation;
+  const blocked = e.stage === 'LOST' ? 'Reopen this Lost enquiry to create an organisation.' : !e.email ? 'Add a contact email first — the invitation goes there.' : '';
+
+  async function create() {
+    setErr(''); setBusy(true);
+    const res = await postBff(`/bff/admin/org-enquiries/${e.id}/create-organisation`);
+    setBusy(false);
+    if (!res.ok) { setErr(res.data?.error || 'Could not create the organisation.'); return; }
+    router.refresh();
+  }
+
+  return (
+    <div className="rounded-2xl border border-line bg-white p-5" data-testid="enq-org-card">
+      <p className="text-xs font-black uppercase tracking-wide text-muted">Organisation</p>
+      {org ? (
+        <div className="mt-2 space-y-1 text-sm">
+          <p className="font-bold text-ink" data-testid="enq-org-name">✓ {org.name} <span className="font-semibold text-muted">· {org.organisation_id}</span></p>
+          {org.claimed ? (
+            <p className="font-semibold text-emerald-700" data-testid="enq-org-claimed">Joined by {org.pending_owner_email} on {(org.claimed_at || '').slice(0, 10)}</p>
+          ) : (
+            <p className="text-amber-700" data-testid="enq-org-pending">Waiting for {org.pending_owner_email} to sign in — it joins their account automatically.</p>
+          )}
+          {e.org_invite && (
+            <p className="text-xs text-muted" data-testid="enq-org-invite">
+              Invitation email {e.org_invite.status === 'sent' ? 'sent' : 'failed'} to {e.org_invite.to} · {(e.org_invite.at || '').replace('T', ' ').slice(0, 16)}
+              {e.org_invite.status !== 'sent' && e.org_invite.error ? ` (${e.org_invite.error})` : ''}
+            </p>
+          )}
+        </div>
+      ) : (
+        <>
+          <p className="mt-1 text-sm text-ink-soft">Create the organisation from this enquiry (name, type, city and contact). {e.contact_name} gets an email to sign in with {e.email || 'their email'} and take it over.</p>
+          {blocked && <p className="mt-2 text-xs font-semibold text-amber-700">{blocked}</p>}
+          {err && <p className="mt-2 text-xs font-semibold text-rose-600" data-testid="enq-org-error">{err}</p>}
+          <button type="button" onClick={create} disabled={busy || !!blocked} data-testid="enq-create-org"
+            className="mt-3 inline-flex min-h-[44px] items-center rounded-xl bg-brand px-4 py-2 text-sm font-bold text-white transition hover:bg-brand-600 disabled:opacity-50">
+            {busy ? 'Creating…' : 'Create organisation & invite contact'}
+          </button>
+        </>
+      )}
+    </div>
+  );
+}

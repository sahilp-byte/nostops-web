+"""Phase C/D feature tests — multi-session scheduling, organiser price estimate,
+programme suggestions (data), enquiry → organisation.
+
+Runs against the local engine on localhost:8001 with throwaway "QA PhaseCD"
+organisations / "TEST" enquiries (delivered@resend.dev — Resend's test inbox).
+Never touches real registrations or demo events.
+
+Run: cd /app/backend && python -m pytest -q tests/test_phase_cd_features.py
+"""
+import base64
+import datetime as dt
+import json
+import os
+import subprocess
+import sys
+import uuid
+
+import pytest
+import requests
+from dotenv import load_dotenv
+from pymongo import MongoClient
+
+sys.path.insert(0, "/app/backend")
+load_dotenv("/app/backend/.env")
+
+API = "http://localhost:8001/api"
+BASE = f"{API}/institutional"
+SECRET = os.environ.get("PULSE_SHARED_SECRET", "")
+DB = MongoClient(os.environ["MONGO_URL"])[os.environ.get("DB_NAME", "nostops_web")]
+RUN = uuid.uuid4().hex[:6]
+CREATOR = {"user_id": f"qa_phasecd_{RUN}", "name": "QA PhaseCD", "email": f"qa.phasecd.{RUN}@nostopsqa.com", "role": "hr"}
+ADMIN = {"user_id": "qa_admin_phasecd", "name": "QA Admin", "role": "admin"}
+
+
+def _h(user=None):
+    h = {"X-Pulse-Secret": SECRET, "Content-Type": "application/json"}
+    if user:
+        h["X-Pulse-User"] = base64.b64encode(json.dumps(user).encode()).decode()
+    return h
+
+
+def _future(days):
+    return (dt.date.today() + dt.timedelta(days=days)).isoformat()
+
+
+@pytest.fixture(scope="module")
+def org_id():
+    r = requests.post(f"{BASE}/organisations", headers=_h(CREATOR), timeout=15, json={
+        "name": f"QA PhaseCD Co {RUN}", "cohort_type": "COMPANY", "contact_email": "people@qa-phasecd.example"})
+    assert r.status_code == 200, r.text
+    return r.json()["organisation"]["organisation_id"]
+
+
+@pytest.fixture(scope="module")
+def programme_id():
+    r = requests.get(f"{BASE}/programmes", headers=_h(), timeout=15)
+    return next(p["programme_id"] for p in r.json()["programmes"] if p["slug"] == "yoga-for-posture-back-care")
+
+
+def _create(org_id, programme_id, **extra):
+    body = {"organisation_id": org_id, "programme_id": programme_id, "title": f"QA PhaseCD Programme {RUN}",
+            "city": "Mumbai", "visibility": "UNLISTED", "start_time": "07:30", "duration_minutes": 45, **extra}
+    return requests.post(f"{BASE}/events", headers=_h(CREATOR), json=body, timeout=15)
+
+
+# ── Multi-session scheduling ──────────────────────────────────────────────────
+def test_recurring_schedule_generates_sessions(org_id, programme_id):
+    start = _future(10)
+    r = _create(org_id, programme_id, event_date=start, capacity=20,
+                schedule={"type": "RECURRING", "weekdays": [2, 4], "months": 3})
+    assert r.status_code == 200, r.text
+    ev = r.json()["event"]
+    sessions = list(DB.inst_event_sessions.find({"event_id": ev["event_id"]}).sort("seq", 1))
+    assert ev["schedule"]["type"] == "RECURRING" and ev["schedule"]["session_count"] == len(sessions)
+    assert 24 <= len(sessions) <= 28  # ~13 weeks × 2
+    assert all(dt.date.fromisoformat(s["date"]).isoweekday() in (2, 4) for s in sessions)
+    assert ev["event_date"] == sessions[0]["date"] >= start
+    assert ev["end_date"] == sessions[-1]["date"]
+    assert sessions[0]["start_time"] == "07:30" and sessions[0]["duration_minutes"] == 45
+    # 3-month company programme, 20 people → Tier 1 = 10% off ₹300
+    pe = ev["price_estimate"]
+    assert pe["months"] == 3 and pe["sessions"] == len(sessions) and pe["pct"] == 10
+    assert pe["rate"] == 270 and pe["total"] == 270 * len(sessions) * 20

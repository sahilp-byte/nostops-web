@@ -0,0 +1,21 @@
+// Admin — turn an organisation enquiry into a ready Organisation (Phase D) and
+// email the contact an invitation to sign in and take it over. Admin + CSRF.
+import type { NextRequest } from 'next/server';
+import { NextResponse } from 'next/server';
+import { requireAdmin } from '@/lib/server/admin-guard';
+import { toErrorText } from '@/lib/server/bff';
+import { orgEnquiryFetch } from '@/lib/server/org-enquiries';
+
+export async function POST(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const guard = await requireAdmin(req);
+  if (!guard.ok) return guard.res;
+  const { id } = await params;
+  try {
+    const up = await orgEnquiryFetch(`/${encodeURIComponent(id)}/create-organisation`, guard.user, { method: 'POST', body: '{}' });
+    const data = await up.json().catch(() => ({}));
+    if (!up.ok) return NextResponse.json({ error: toErrorText(data?.detail, 'Could not create the organisation.') }, { status: up.status });
+    return NextResponse.json(data);
+  } catch {
+    return NextResponse.json({ error: 'Enquiry service unavailable.' }, { status: 504 });
+  }
+}

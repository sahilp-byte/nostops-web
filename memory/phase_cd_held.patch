+def test_python_pricing_matches_frontend_pricing_ts():
+    import org_pricing
+    cases = [(c, m, p, s) for c in ("COMPANY", "STARTUP_NETWORK", "EDUCATIONAL_INSTITUTION")
+             for m in (1, 3, 6, 12) for p in (15, 28, 29, 40) for s in (None, 26)]
+    js = ("import { estimate } from '/app/frontend/lib/org/pricing.ts';"
+          f"const cases = {json.dumps(cases)};"
+          "console.log(JSON.stringify(cases.map(([c,m,p,s]) => s === null ? estimate(c,m,p) : estimate(c,m,p,s))));")
+    out = subprocess.run(["node", "--input-type=module", "-e", js], capture_output=True, text=True, timeout=60)
+    assert out.returncode == 0, out.stderr
+    ts = json.loads(out.stdout.strip().splitlines()[-1])
+    for (c, m, p, s), t in zip(cases, ts):
+        py = org_pricing.estimate(c, m, p, s)
+        assert py["rate"] == t["rate"] and py["pct"] == t["pct"] and py["total"] == t["total"], (c, m, p, s)
+
+
+# ── Enquiry → Organisation ───────────────────────────────────────────────────
+def _make_enquiry(**over):
+    eid = f"qa-phasecd-{uuid.uuid4().hex[:10]}"
+    doc = {"_id": eid, "ref": f"ENQ-QA-{RUN}", "organisation_name": f"TEST PhaseCD Enquiry Org {RUN}",
+           "contact_name": "Asha QA", "designation": "People Lead", "email": "delivered@resend.dev",
+           "phone": "+91 98200 12345", "cohort": "STARTUP_NETWORK", "city": "Pune", "participants": "15_28",
+           "interests": ["MIND"], "duration": "3_MONTHS", "start_period": "NEXT_MONTH", "message": None,
+           "stage": "WON", "history": [], "notes": [], "created_at": "2026-01-01T00:00:00+00:00",
+           "updated_at": "2026-01-01T00:00:00+00:00", **over}
+    DB.org_enquiries.insert_one(doc)
+    return eid
+
+
+def test_enquiry_to_organisation_and_claim_on_first_sign_in():
+    eid = _make_enquiry()
+    r = requests.post(f"{API}/org-enquiries/{eid}/create-organisation", headers=_h(ADMIN), timeout=30)
+    assert r.status_code == 200, r.text
+    body = r.json()
+    assert body["created"] is True and body["organisation"]["claimed"] is False
+    oid = body["organisation"]["organisation_id"]
+    org = DB.inst_organisations.find_one({"organisation_id": oid})
+    assert org["name"] == f"TEST PhaseCD Enquiry Org {RUN}" and org["cohort_type"] == "STARTUP_NETWORK"
+    assert org["primary_city"] == "Pune" and org["contact_person"] == "Asha QA" and org["contact_phone"] == "+91 98200 12345"
+    assert org["pending_owner_email"] == "delivered@resend.dev"
+    assert DB.inst_org_members.count_documents({"organisation_id": oid}) == 0
+    assert body["invite"]["to"] == "delivered@resend.dev" and body["invite"]["status"] in ("sent", "failed")
+    # Idempotent second click.
+    again = requests.post(f"{API}/org-enquiries/{eid}/create-organisation", headers=_h(ADMIN), timeout=30).json()
+    assert again["created"] is False and again["organisation"]["organisation_id"] == oid
+    # A different user does NOT get it.
+    other = {"user_id": f"qa_other_{RUN}", "name": "Other", "email": "someone.else@nostopsqa.com", "role": "learner"}
+    lst = requests.get(f"{BASE}/organisations", headers=_h(other), timeout=15).json()["organisations"]
+    assert oid not in [o["organisation_id"] for o in lst]
+    # First signed-in visit by the contact email → joined as OWNER.
+    contact = {"user_id": f"qa_contact_{RUN}", "name": "Asha QA", "email": "Delivered@Resend.dev", "role": "learner"}
+    lst = requests.get(f"{BASE}/organisations", headers=_h(contact), timeout=15).json()["organisations"]
+    mine = [o for o in lst if o["organisation_id"] == oid]
+    assert mine and mine[0]["my_role"] == "OWNER"
+    status = requests.get(f"{API}/org-enquiries/{eid}", headers=_h(ADMIN), timeout=15).json()
+    assert status["organisation"]["claimed"] is True and status["organisation_id"] == oid
+    # Claimed once only — a later different account with the same email does not double-claim.
+    dup = {**contact, "user_id": f"qa_contact2_{RUN}"}
+    lst2 = requests.get(f"{BASE}/organisations", headers=_h(dup), timeout=15).json()["organisations"]
+    assert oid not in [o["organisation_id"] for o in lst2]
+    # The new owner can create a programme for it.
+    pid = requests.get(f"{BASE}/programmes", headers=_h(), timeout=15).json()["programmes"][0]["programme_id"]
+    ev = requests.post(f"{BASE}/events", headers=_h(contact), timeout=15, json={
+        "organisation_id": oid, "programme_id": pid, "title": "QA PhaseCD claimed org programme"})
+    assert ev.status_code == 200, ev.text
+
+
+def test_enquiry_to_org_guards():
+    lost = _make_enquiry(stage="LOST")
+    r = requests.post(f"{API}/org-enquiries/{lost}/create-organisation", headers=_h(ADMIN), timeout=15)
+    assert r.status_code == 400
+    noemail = _make_enquiry(email=None)
+    r = requests.post(f"{API}/org-enquiries/{noemail}/create-organisation", headers=_h(ADMIN), timeout=15)
+    assert r.status_code == 400
+    ok = _make_enquiry()
+    r = requests.post(f"{API}/org-enquiries/{ok}/create-organisation", headers=_h(CREATOR), timeout=15)
+    assert r.status_code == 403  # admins only
